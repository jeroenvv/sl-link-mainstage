<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.files.user-selected.read-only</key>
	<true/>
	<!--
	Scoped read access for the MainStage bridge - see docs/mainstage-integration.md's
	"Open question before the app side can be wired up" section. MainStageScript/STUDIOLOGIC/SL.device/
	config.lua (an unsandboxed MainStage Lua process) writes the bridge's live status/patch-list here;
	without this, App Sandbox's default container-only file access means this app cannot read them back.
	Deliberately scoped to exactly these two absolute paths, not a directory or a broader exception -
	narrower than com.apple.security.temporary-exception.files.absolute-path.read-write, which this app
	doesn't need since it never writes to these files itself.

	MUST be the resolved /private/tmp path, not the /tmp symlink - confirmed empirically with a
	minimal sandboxed probe app: the exact same entitlement listing /tmp/... denied the read, and
	listing /private/tmp/... (same underlying file, /tmp is a symlink to private/tmp) allowed it.
	Sandbox path matching for this entitlement does not resolve symlinks.
	-->
	<key>com.apple.security.temporary-exception.files.absolute-path.read-only</key>
	<array>
		<string>/private/tmp/sl-mainstage-bridge-status.bin</string>
		<string>/private/tmp/sl-mainstage-bridge-patchlist.bin</string>
	</array>
</dict>
</plist>
